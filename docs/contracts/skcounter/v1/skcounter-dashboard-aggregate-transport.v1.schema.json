{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skworld.local/skdashboard/skcounter-dashboard-aggregate-transport.v1.schema.json",
  "title": "SKCounter dashboard aggregate transport v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "target",
    "generated_at",
    "fresh_until",
    "payload_sha256",
    "payload_bytes",
    "rows",
    "records",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "skcounter.dashboard-aggregate-transport.v1"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "host_fqdn", "endpoint", "index_schema_version"],
      "properties": {
        "service_id": {"const": "skcounter-collector@chiap04"},
        "host_fqdn": {"const": "chiap04.tail204f0c.ts.net"},
        "endpoint": {"const": "https://chiap04.tail204f0c.ts.net:9398/v1/dashboard/aggregates/latest"},
        "index_schema_version": {"const": "skcounter.latest-observation-index.v1"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_id", "host_fqdn", "audience", "capability"],
      "properties": {
        "service_id": {"const": "skdashboard-read-only@chiap08"},
        "host_fqdn": {"const": "chiap08.tail204f0c.ts.net"},
        "audience": {"const": "skcounter"},
        "capability": {"const": "skcounter.dashboard.aggregates.read"}
      }
    },
    "generated_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "fresh_until": {"type": "string", "format": "date-time", "maxLength": 64},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "payload_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
    "rows": {"type": "integer", "minimum": 1, "maximum": 10000},
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/record"}
    },
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bounded_id": {"type": "string", "pattern": "^[A-Za-z0-9._@-]{1,128}$"},
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cache_read", "cache_write", "reasoning", "total"],
      "properties": {
        "input": {"type": "integer", "minimum": 0},
        "output": {"type": "integer", "minimum": 0},
        "cache_read": {"type": "integer", "minimum": 0},
        "cache_write": {"type": "integer", "minimum": 0},
        "reasoning": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "estimated", "pricing_revision"],
      "properties": {
        "amount": {"type": "number", "minimum": 0},
        "currency": {"const": "USD"},
        "estimated": {"type": "boolean"},
        "pricing_revision": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "timed_tokens", "sample_count", "token_coverage"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "timed_tokens": {"type": "integer", "minimum": 0},
        "sample_count": {"type": "integer", "minimum": 0},
        "token_coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "ms_per_1k_tokens": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active_seconds", "longest_continuous_seconds", "max_concurrent"],
      "properties": {
        "active_seconds": {"type": "integer", "minimum": 0},
        "longest_continuous_seconds": {"type": "integer", "minimum": 0},
        "max_concurrent": {"type": "integer", "minimum": 0}
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["view", "bucket_start", "tokens"],
      "properties": {
        "view": {"enum": ["models", "daily", "hourly", "time_metrics"]},
        "bucket_start": {"type": "string", "format": "date-time", "maxLength": 64},
        "client": {"type": "string", "minLength": 1, "maxLength": 128},
        "provider": {"type": "string", "minLength": 1, "maxLength": 128},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "tokens": {"$ref": "#/$defs/tokens"},
        "message_count": {"type": "integer", "minimum": 0},
        "cost": {"$ref": "#/$defs/cost"},
        "performance": {"$ref": "#/$defs/performance"},
        "activity": {"$ref": "#/$defs/activity"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "measurement_lane",
        "node_id",
        "principal_id",
        "observed_at",
        "idempotency_key",
        "payload_hash",
        "source_observation_sha256",
        "aggregate"
      ],
      "properties": {
        "schema_version": {"const": "skcounter.dashboard-aggregate.v1"},
        "measurement_lane": {"enum": ["harness_reported", "gateway_observed"]},
        "node_id": {"$ref": "#/$defs/bounded_id"},
        "principal_id": {"$ref": "#/$defs/bounded_id"},
        "observed_at": {"type": "string", "format": "date-time", "maxLength": 64},
        "idempotency_key": {"$ref": "#/$defs/sha256"},
        "payload_hash": {"$ref": "#/$defs/sha256"},
        "source_observation_sha256": {"$ref": "#/$defs/sha256"},
        "aggregate": {"$ref": "#/$defs/aggregate"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_sha256", "record_sha256s", "collector_version"],
      "properties": {
        "index_sha256": {"$ref": "#/$defs/sha256"},
        "record_sha256s": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "collector_version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    }
  }
}
